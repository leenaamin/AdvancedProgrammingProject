<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- The side menu shared by all the windows (included with <fx:include source="sidebar.fxml"/>) -->
<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.plantcare.plantcare.controller.SidebarController"
      spacing="14.0" prefWidth="175.0"
      style="-fx-background-color: #355b3b;">
    <padding>
        <Insets top="24.0" right="14.0" bottom="20.0" left="14.0" />
    </padding>

    <Label text="🌿 PlantCare"
           style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />
    <Label text="MENU"
           style="-fx-text-fill: #dce8d7; -fx-font-size: 10px;" />

    <Button text="🌱  My Plants" onAction="#showPlants" maxWidth="Infinity" alignment="CENTER_LEFT"
            style="-fx-text-fill: white; -fx-font-size: 14px; -fx-background-color: #56775b; -fx-padding: 10px;" />
    <Button text="📋  Care Plans" onAction="#showCarePlans" maxWidth="Infinity" alignment="CENTER_LEFT"
            style="-fx-text-fill: white; -fx-font-size: 14px; -fx-background-color: #56775b; -fx-padding: 10px;" />
    <Button text="💧  Watering" onAction="#showWatering" maxWidth="Infinity" alignment="CENTER_LEFT"
            style="-fx-text-fill: white; -fx-font-size: 14px; -fx-background-color: #56775b; -fx-padding: 10px;" />
</VBox>
