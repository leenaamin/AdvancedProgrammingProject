<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.plantcare.plantcare.controller.CarePlanController"
            stylesheets="@style.css" styleClass="page">

    <left>
        <fx:include source="sidebar.fxml" />
    </left>

    <center>
        <HBox spacing="18.0">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>

            <!-- Search, filter, sort and the table -->
            <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                <Label text="Care Plans"
                       style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #304b34;" />
                <Label text="Set the watering, fertilizer and light needs of each plant."
                       style="-fx-text-fill: #687568;" />

                <HBox spacing="8.0">
                    <TextField fx:id="searchField" promptText="Search by plant name" HBox.hgrow="ALWAYS" />
                    <ComboBox fx:id="lightFilter" prefWidth="100.0" />
                    <ComboBox fx:id="sortBox" prefWidth="140.0" />
                </HBox>

                <TableView fx:id="table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameCol" text="Plant" prefWidth="150.0" />
                        <TableColumn fx:id="wateringCol" text="Watering" prefWidth="110.0" />
                        <TableColumn fx:id="fertilizerCol" text="Fertilizer" prefWidth="80.0" />
                        <TableColumn fx:id="lightCol" text="Light" prefWidth="80.0" />
                    </columns>
                </TableView>
            </VBox>

            <!-- The form -->
            <VBox spacing="12.0" prefWidth="235.0"
                  style="-fx-background-color: white; -fx-background-radius: 10px;">
                <padding>
                    <Insets top="18.0" right="16.0" bottom="18.0" left="16.0" />
                </padding>

                <Label text="Add / Edit Care Plan"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #304b34;" />
                <Label text="Choose a plant and set its needs."
                       style="-fx-text-fill: #687568;" />

                <ComboBox fx:id="plantBox" promptText="Choose a plant" maxWidth="Infinity" />
                <TextField fx:id="wateringDaysField" promptText="Water every (days)" />
                <CheckBox fx:id="fertilizerCheck" text="Needs fertilizer" />
                <ComboBox fx:id="lightBox" promptText="Light level" maxWidth="Infinity" />

                <Button text="Add Care Plan"
                        onAction="#onAdd"
                        maxWidth="Infinity"
                        style="-fx-background-color: #527b4f; -fx-text-fill: white;" />
                <Button fx:id="updateButton" text="Update Selected"
                        onAction="#onUpdate"
                        maxWidth="Infinity" />
                <Button fx:id="deleteButton" text="Delete Selected"
                        onAction="#onDelete"
                        maxWidth="Infinity"
                        style="-fx-background-color: #f2e6e2; -fx-text-fill: #8b4236;" />
                <Button text="Clear"
                        onAction="#onClear"
                        maxWidth="Infinity" />
            </VBox>
        </HBox>
    </center>
</BorderPane>
