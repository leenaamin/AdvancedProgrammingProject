<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.plantcare.plantcare.controller.WateringController"
            stylesheets="@style.css" styleClass="page">

    <left>
        <fx:include source="sidebar.fxml" />
    </left>

    <center>
        <HBox spacing="18.0">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>

            <!-- Status filter, the table (nearest watering date first) and Mark as Watered -->
            <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                <Label text="Watering Schedule"
                       style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #304b34;" />
                <Label text="Follow the watering dates of your plants."
                       style="-fx-text-fill: #687568;" />

                <HBox spacing="8.0" alignment="CENTER_LEFT">
                    <Label text="Show:" style="-fx-text-fill: #687568;" />
                    <ComboBox fx:id="statusFilter" prefWidth="130.0" />
                </HBox>

                <TableView fx:id="table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameCol" text="Plant" prefWidth="130.0" />
                        <TableColumn fx:id="lastCol" text="Last watered" prefWidth="100.0" />
                        <TableColumn fx:id="intervalCol" text="Interval" prefWidth="90.0" />
                        <TableColumn fx:id="nextCol" text="Next watering" prefWidth="100.0" />
                        <TableColumn fx:id="statusCol" text="Status" prefWidth="70.0" />
                    </columns>
                </TableView>

                <Button fx:id="wateredButton" text="Mark as Watered"
                        onAction="#onMarkWatered"
                        maxWidth="Infinity"
                        style="-fx-background-color: #527b4f; -fx-text-fill: white;" />
            </VBox>

            <!-- The form -->
            <VBox spacing="12.0" prefWidth="235.0"
                  style="-fx-background-color: white; -fx-background-radius: 10px;">
                <padding>
                    <Insets top="18.0" right="16.0" bottom="18.0" left="16.0" />
                </padding>

                <Label text="Add to Schedule"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #304b34;" />
                <Label text="Choose a plant that has a care plan."
                       style="-fx-text-fill: #687568;" />

                <ComboBox fx:id="planBox" promptText="Choose a plant" maxWidth="Infinity" />
                <Label text="Last watered" style="-fx-text-fill: #687568;" />
                <DatePicker fx:id="lastWateredPicker" maxWidth="Infinity" />

                <Button text="Add to Schedule"
                        onAction="#onAdd"
                        maxWidth="Infinity"
                        style="-fx-background-color: #527b4f; -fx-text-fill: white;" />
            </VBox>
        </HBox>
    </center>
</BorderPane>
