<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.plantcare.plantcare.controller.PlantController"
            stylesheets="@style.css" styleClass="page">

    <!-- Changed: the side menu is now shared by all the windows -->
    <left>
        <fx:include source="sidebar.fxml" />
    </left>

    <center>
        <HBox spacing="18.0">
            <padding>
                <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
            </padding>

            <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                <Label text="My Plants"
                       style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #304b34;" />
                <Label text="Manage your plants, types, and locations."
                       style="-fx-text-fill: #687568;" />

                <HBox spacing="8.0">
                    <TextField fx:id="searchField"
                               promptText="Search by name"
                               onKeyReleased="#filterPlants"
                               HBox.hgrow="ALWAYS" />
                    <TextField fx:id="typeFilterField"
                               promptText="Filter by type"
                               onKeyReleased="#filterPlants"
                               prefWidth="125.0" />
                    <TextField fx:id="locationFilterField"
                               promptText="Filter by location"
                               onKeyReleased="#filterPlants"
                               prefWidth="135.0" />
                </HBox>

                <TableView fx:id="plantTable"
                           onMouseClicked="#selectPlant"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameColumn"
                                     text="Plant Name"
                                     prefWidth="180.0" />
                        <TableColumn fx:id="typeColumn"
                                     text="Type"
                                     prefWidth="130.0" />
                        <TableColumn fx:id="locationColumn"
                                     text="Location"
                                     prefWidth="150.0" />
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="12.0" prefWidth="235.0"
                  style="-fx-background-color: white; -fx-background-radius: 10px;">
                <padding>
                    <Insets top="18.0" right="16.0" bottom="18.0" left="16.0" />
                </padding>

                <Label text="Add / Edit Plant"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #304b34;" />
                <Label text="Enter the plant details below."
                       style="-fx-text-fill: #687568;" />

                <TextField fx:id="nameField" promptText="Plant name" />
                <TextField fx:id="typeField" promptText="Plant type" />
                <TextField fx:id="locationField" promptText="Plant location" />

                <Button text="Add Plant"
                        onAction="#addPlant"
                        maxWidth="Infinity"
                        style="-fx-background-color: #527b4f; -fx-text-fill: white;" />
                <Button text="Update Selected"
                        onAction="#updatePlant"
                        maxWidth="Infinity" />
                <Button text="Delete Selected"
                        onAction="#deletePlant"
                        maxWidth="Infinity"
                        style="-fx-background-color: #f2e6e2; -fx-text-fill: #8b4236;" />
            </VBox>
        </HBox>
    </center>
</BorderPane>
